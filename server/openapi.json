{
  "openapi": "3.1.0",
  "info": {
    "title": "Commercial Wire Maker-Checker API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/wires": {
      "get": {
        "summary": "Get All Wires",
        "operationId": "get_all_wires_api_wires_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/WireTransferResponse"
                  },
                  "type": "array",
                  "title": "Response Get All Wires Api Wires Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Wire",
        "operationId": "create_wire_api_wires_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WireCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WireTransferResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/wires/pending": {
      "get": {
        "summary": "Get Pending Wires",
        "operationId": "get_pending_wires_api_wires_pending_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/WireTransferResponse"
                  },
                  "type": "array",
                  "title": "Response Get Pending Wires Api Wires Pending Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/wires/{wire_id}/approve": {
      "put": {
        "summary": "Approve Wire",
        "operationId": "approve_wire_api_wires__wire_id__approve_put",
        "parameters": [
          {
            "name": "wire_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Wire Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WireApprovalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WireTransferResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/wires/{wire_id}/reject": {
      "put": {
        "summary": "Reject Wire",
        "operationId": "reject_wire_api_wires__wire_id__reject_put",
        "parameters": [
          {
            "name": "wire_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Wire Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WireApprovalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WireTransferResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WireApprovalRequest": {
        "properties": {
          "approvedBy": {
            "type": "string",
            "title": "Approvedby",
            "description": "User ID of the Checker approving or rejecting the transfer"
          }
        },
        "type": "object",
        "required": [
          "approvedBy"
        ],
        "title": "WireApprovalRequest"
      },
      "WireCreateRequest": {
        "properties": {
          "beneficiaryName": {
            "type": "string",
            "title": "Beneficiaryname",
            "description": "Name of the recipient"
          },
          "accountNumber": {
            "type": "string",
            "title": "Accountnumber",
            "description": "Account number"
          },
          "routingNumber": {
            "type": "string",
            "title": "Routingnumber",
            "description": "Routing transit number"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Amount",
            "description": "Transfer amount in USD"
          },
          "createdBy": {
            "type": "string",
            "title": "Createdby",
            "description": "User ID of the Maker creating the transfer"
          }
        },
        "type": "object",
        "required": [
          "beneficiaryName",
          "accountNumber",
          "routingNumber",
          "amount",
          "createdBy"
        ],
        "title": "WireCreateRequest"
      },
      "WireTransferResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "beneficiaryName": {
            "type": "string",
            "title": "Beneficiaryname"
          },
          "accountNumber": {
            "type": "string",
            "title": "Accountnumber"
          },
          "routingNumber": {
            "type": "string",
            "title": "Routingnumber"
          },
          "amount": {
            "type": "number",
            "title": "Amount"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "createdBy": {
            "type": "string",
            "title": "Createdby"
          },
          "approvedBy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approvedby"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Updatedat"
          }
        },
        "type": "object",
        "required": [
          "id",
          "beneficiaryName",
          "accountNumber",
          "routingNumber",
          "amount",
          "status",
          "createdBy",
          "createdAt",
          "updatedAt"
        ],
        "title": "WireTransferResponse"
      }
    }
  }
}