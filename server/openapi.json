        ],
        "summary": "Approve Wire",
        "description": "Approves a pending wire transfer.\nEnforces Maker-Checker segregation: approvedBy MUST NOT equal createdBy.\nReturns HTTP 403 Forbidden if the creator attempts self-approval.",
