{
  "openapi": "3.1.0",
  "info": {
    "title": "ACH Velocity Limits API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/ach/transfers/evaluate": {
      "post": {
        "tags": [
          "ACH Transfers"
        ],
        "summary": "Evaluate Ach Transfer",
        "operationId": "evaluate_ach_transfer_api_v1_ach_transfers_evaluate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AchTransferEvaluateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "ACH Transfer evaluated and approved (may have requires_aml_review=True if > $5,000)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AchTransferResponse"
                }
              }
            }
          },
          "429": {
            "description": "Velocity limit exceeded (> $10,000 in rolling 24-hour period)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VelocityLimitExceededResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AchTransferEvaluateRequest": {
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid",
            "title": "Account Id",
            "description": "Customer account unique identifier"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Amount",
            "description": "Transfer amount in USD, must be greater than 0"
          },
          "recipient_account": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Recipient Account",
            "description": "Recipient account number"
          },
          "routing_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Routing Number",
            "description": "9-digit ACH routing transit number"
          }
        },
        "type": "object",
        "required": [
          "account_id",
          "amount"
        ],
        "title": "AchTransferEvaluateRequest"
      },
      "AchTransferResponse": {
        "properties": {
          "transfer_id": {
            "type": "string",
            "format": "uuid",
            "title": "Transfer Id",
            "description": "Unique transaction ID"
          },
          "account_id": {
            "type": "string",
            "format": "uuid",
            "title": "Account Id",
            "description": "Customer account identifier"
          },
          "amount": {
            "type": "number",
            "title": "Amount",
            "description": "Transaction amount in USD"
          },
          "rolling_24h_total": {
            "type": "number",
            "title": "Rolling 24H Total",
            "description": "Total outbound ACH sum in rolling 24h including this transaction"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Transaction status (e.g. APPROVED)"
          },
          "requires_aml_review": {
            "type": "boolean",
            "title": "Requires Aml Review",
            "description": "Flag indicating if transaction requires AML compliance review"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "Transaction creation timestamp (UTC)"
          }
        },
        "type": "object",
        "required": [
          "transfer_id",
          "account_id",
          "amount",
          "rolling_24h_total",
          "status",
          "requires_aml_review",
          "created_at"
        ],
        "title": "AchTransferResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VelocityLimitExceededResponse": {
        "properties": {
          "error_code": {
            "type": "string",
            "title": "Error Code",
            "description": "Error code identifier",
            "default": "VELOCITY_LIMIT_EXCEEDED"
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "description": "Descriptive error detail",
            "default": "Rolling 24-hour ACH transfer limit exceeded."
          },
          "account_id": {
            "type": "string",
            "format": "uuid",
            "title": "Account Id",
            "description": "Customer account identifier"
          },
          "attempted_amount": {
            "type": "number",
            "title": "Attempted Amount",
            "description": "Amount attempted in this request"
          },
          "current_24h_total": {
            "type": "number",
            "title": "Current 24H Total",
            "description": "Current 24h outbound sum prior to this request"
          },
          "projected_24h_total": {
            "type": "number",
            "title": "Projected 24H Total",
            "description": "Projected 24h sum including the attempted amount"
          },
          "limit": {
            "type": "number",
            "title": "Limit",
            "description": "Velocity limit threshold in USD",
            "default": 10000.0
          }
        },
        "type": "object",
        "required": [
          "account_id",
          "attempted_amount",
          "current_24h_total",
          "projected_24h_total"
        ],
        "title": "VelocityLimitExceededResponse"
      }
    }
  }
}
