            "title": "Beneficiaryname"
          },
          "accountNumber": {
            "type": "string",
            "minLength": 1,
            "title": "Accountnumber"
          },
          "routingNumber": {
            "type": "string",
            "minLength": 1,
            "title": "Routingnumber"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Amount"
          },
          "createdBy": {
            "type": "string",
            "minLength": 1,
            "title": "Createdby"
          }
        },
        "type": "object",
        "required": [
          "beneficiaryName",
          "accountNumber",
          "routingNumber",
          "amount",
          "createdBy"
        ],
        "title": "WireTransferCreate"
      },
      "WireTransferResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "beneficiaryName": {
            "type": "string",
            "title": "Beneficiaryname"
          },
          "accountNumber": {
            "type": "string",
            "title": "Accountnumber"
          },
          "routingNumber": {
            "type": "string",
            "title": "Routingnumber"
          },
          "amount": {
            "type": "number",
            "title": "Amount"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "createdBy": {
            "type": "string",
            "title": "Createdby"
          },
          "approvedBy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approvedby"
          },
          "createdAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Createdat"
          },
          "updatedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updatedat"
          }
        },
        "type": "object",
        "required": [
          "id",
          "beneficiaryName",
          "accountNumber",
          "routingNumber",
          "amount",
          "status",
          "createdBy"
