{
  "openapi": "3.1.0",
  "info": {
    "title": "Commercial Wire Maker-Checker API",
    "description": "Backend API for Commercial Wire Management with Dual Control and Automated Threshold Approval",
    "version": "1.0.0"
  },
  "paths": {
    "/api/wires/": {
      "post": {
        "tags": [
          "Wire Transfers"
        ],
        "summary": "Create Wire",
        "description": "Initiate a new wire transfer.\n- If amount > $10,000.00: Status set to PENDING (requires Checker approval).\n- If amount <= $10,000.00: Status automatically set to APPROVED.",
        "operationId": "create_wire_api_wires__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WireCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WireResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/wires": {
      "post": {
        "tags": [
          "Wire Transfers"
        ],
        "summary": "Create Wire",
        "description": "Initiate a new wire transfer.\n- If amount > $10,000.00: Status set to PENDING (requires Checker approval).\n- If amount <= $10,000.00: Status automatically set to APPROVED.",
        "operationId": "create_wire_api_wires_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WireCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WireResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/wires/pending": {
      "get": {
        "tags": [
          "Wire Transfers"
        ],
        "summary": "Get Pending Wires",
        "description": "Retrieve all wire transfers with PENDING status.",
        "operationId": "get_pending_wires_api_wires_pending_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/WireResponse"
                  },
                  "type": "array",
                  "title": "Response Get Pending Wires Api Wires Pending Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/wires/{wire_id}/approve": {
      "put": {
        "tags": [
          "Wire Transfers"
        ],
        "summary": "Approve Wire",
        "description": "Approve a pending wire transfer.\nEnforces Segregation of Duties: approvedBy must NOT equal createdBy (returns 403 Forbidden).",
        "operationId": "approve_wire_api_wires__wire_id__approve_put",
        "parameters": [
          {
            "name": "wire_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Wire Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WireApprove"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WireResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/wires/{wire_id}/reject": {
      "put": {
        "tags": [
          "Wire Transfers"
        ],
        "summary": "Reject Wire",
        "description": "Reject a pending wire transfer.",
        "operationId": "reject_wire_api_wires__wire_id__reject_put",
        "parameters": [
          {
            "name": "wire_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Wire Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WireReject"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WireResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WireApprove": {
        "properties": {
          "approvedBy": {
            "type": "string",
            "minLength": 1,
            "title": "Approvedby",
            "description": "User ID or name of the Checker approving the wire"
          }
        },
        "type": "object",
        "required": [
          "approvedBy"
        ],
        "title": "WireApprove"
      },
      "WireCreate": {
        "properties": {
          "beneficiaryName": {
            "type": "string",
            "minLength": 1,
            "title": "Beneficiaryname",
            "description": "Legal name of beneficiary"
          },
          "accountNumber": {
            "type": "string",
            "minLength": 1,
            "title": "Accountnumber",
            "description": "Beneficiary bank account number"
          },
          "routingNumber": {
            "type": "string",
            "minLength": 1,
            "title": "Routingnumber",
            "description": "ABA routing / transit number"
          },
          "amount": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Amount",
            "description": "Wire transfer amount in USD"
          },
          "createdBy": {
            "type": "string",
            "minLength": 1,
            "title": "Createdby",
            "description": "User ID or name of the Maker initiating the wire"
          }
        },
        "type": "object",
        "required": [
          "beneficiaryName",
          "accountNumber",
          "routingNumber",
          "amount",
          "createdBy"
        ],
        "title": "WireCreate"
      },
      "WireReject": {
        "properties": {
          "approvedBy": {
            "type": "string",
            "minLength": 1,
            "title": "Approvedby",
            "description": "User ID or name of the Checker rejecting the wire"
          }
        },
        "type": "object",
        "required": [
          "approvedBy"
        ],
        "title": "WireReject"
      },
      "WireResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "beneficiaryName": {
            "type": "string",
            "title": "Beneficiaryname"
          },
          "accountNumber": {
            "type": "string",
            "title": "Accountnumber"
          },
          "routingNumber": {
            "type": "string",
            "title": "Routingnumber"
          },
          "amount": {
            "type": "number",
            "title": "Amount"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "createdBy": {
            "type": "string",
            "title": "Createdby"
          },
          "approvedBy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approvedby"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "beneficiaryName",
          "accountNumber",
          "routingNumber",
          "amount",
          "status",
          "createdBy",
          "created_at",
          "updated_at"
        ],
        "title": "WireResponse"
      }
    }
  }
}