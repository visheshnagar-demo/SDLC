{
  "openapi": "3.1.0",
  "info": {
    "title": "Sales Orders ETL Service",
    "description": "PostgreSQL to BigQuery Sales Orders ETL Pipeline Service",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/etl/sales-orders/run": {
      "post": {
        "tags": [
          "ETL Pipeline"
        ],
        "summary": "Trigger the Sales Orders ETL pipeline",
        "description": "Extracts raw sales orders from PostgreSQL, applies data quality rules (filters missing amounts and invalid emails), and loads cleaned records into BigQuery fct_sales_orders partitioned by order date.",
        "operationId": "run_sales_orders_etl_api_v1_etl_sales_orders_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ETLJobRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ETLJobResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/etl/sales-orders/status/{job_id}": {
      "get": {
        "tags": [
          "ETL Pipeline"
        ],
        "summary": "Get ETL job status and telemetry",
        "operationId": "get_job_status_api_v1_etl_sales_orders_status__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ETLJobStatusResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/etl/sales-orders/seed": {
      "post": {
        "tags": [
          "ETL Pipeline"
        ],
        "summary": "Seed source raw_sales_orders with test dataset",
        "operationId": "seed_raw_data_api_v1_etl_sales_orders_seed_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/etl/sales-orders/quarantine/{job_id}": {
      "get": {
        "tags": [
          "ETL Pipeline"
        ],
        "summary": "Retrieve quarantined records for a job",
        "operationId": "get_quarantined_records_api_v1_etl_sales_orders_quarantine__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "General"
        ],
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/livez": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Check",
        "operationId": "health_check_livez_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Check",
        "operationId": "health_check_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ETLJobBreakdown": {
        "properties": {
          "missing_amount": {
            "type": "integer",
            "title": "Missing Amount",
            "description": "Records dropped due to null or missing amount",
            "default": 0
          },
          "invalid_email": {
            "type": "integer",
            "title": "Invalid Email",
            "description": "Records dropped due to invalid email address format",
            "default": 0
          }
        },
        "type": "object",
        "title": "ETLJobBreakdown"
      },
      "ETLJobMetrics": {
        "properties": {
          "records_extracted": {
            "type": "integer",
            "title": "Records Extracted",
            "description": "Total raw records extracted from source",
            "default": 0
          },
          "records_loaded": {
            "type": "integer",
            "title": "Records Loaded",
            "description": "Cleaned records successfully loaded into BigQuery",
            "default": 0
          },
          "records_quarantined": {
            "type": "integer",
            "title": "Records Quarantined",
            "description": "Total records rejected by data quality engine",
            "default": 0
          },
          "breakdown": {
            "$ref": "#/components/schemas/ETLJobBreakdown",
            "description": "Categorized drop reasons"
          },
          "duration_ms": {
            "type": "integer",
            "title": "Duration Ms",
            "description": "Total execution duration in milliseconds",
            "default": 0
          }
        },
        "type": "object",
        "title": "ETLJobMetrics"
      },
      "ETLJobRequest": {
        "properties": {
          "start_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Date",
            "description": "Filter records on or after this order_date (YYYY-MM-DD)"
          },
          "end_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Date",
            "description": "Filter records on or before this order_date (YYYY-MM-DD)"
          },
          "batch_size": {
            "type": "integer",
            "maximum": 50000.0,
            "minimum": 1.0,
            "title": "Batch Size",
            "description": "Batch chunk size for extraction and loading",
            "default": 1000
          }
        },
        "type": "object",
        "title": "ETLJobRequest"
      },
      "ETLJobResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id",
            "description": "Unique ETL execution identifier"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Execution status: COMPLETED, FAILED, RUNNING"
          },
          "metrics": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ETLJobMetrics"
              },
              {
                "type": "null"
              }
            ],
            "description": "Execution metrics"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp",
            "description": "Completion timestamp"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message",
            "description": "Error details if job failed"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status"
        ],
        "title": "ETLJobResponse"
      },
      "ETLJobStatusResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id",
            "description": "Unique ETL execution identifier"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Current status: RUNNING, COMPLETED, FAILED"
          },
          "progress_percentage": {
            "type": "number",
            "title": "Progress Percentage",
            "description": "Job progress percentage (0.0 to 100.0)",
            "default": 100.0
          },
          "metrics": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ETLJobMetrics"
              },
              {
                "type": "null"
              }
            ],
            "description": "Job metrics summary"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At",
            "description": "Start timestamp"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At",
            "description": "End timestamp"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status"
        ],
        "title": "ETLJobStatusResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}