{
  "openapi": "3.1.0",
  "info": {
    "title": "Sales Data ETL Pipeline Service",
    "description": "Extracts raw sales orders from PostgreSQL, filters invalid records, and loads partitioned rows into BigQuery.",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "General"
        ],
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Check",
        "operationId": "health_check_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pipeline/run": {
      "post": {
        "tags": [
          "Pipeline"
        ],
        "summary": "Run Pipeline",
        "operationId": "run_pipeline_api_v1_pipeline_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PipelineRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineRunResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "database_connected": {
            "type": "boolean",
            "title": "Database Connected"
          },
          "bigquery_accessible": {
            "type": "boolean",
            "title": "Bigquery Accessible"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database_connected",
          "bigquery_accessible"
        ],
        "title": "HealthResponse"
      },
      "PipelineMetrics": {
        "properties": {
          "extracted_count": {
            "type": "integer",
            "title": "Extracted Count",
            "default": 0
          },
          "filtered_missing_amount": {
            "type": "integer",
            "title": "Filtered Missing Amount",
            "default": 0
          },
          "filtered_invalid_email": {
            "type": "integer",
            "title": "Filtered Invalid Email",
            "default": 0
          },
          "total_filtered": {
            "type": "integer",
            "title": "Total Filtered",
            "default": 0
          },
          "loaded_count": {
            "type": "integer",
            "title": "Loaded Count",
            "default": 0
          }
        },
        "type": "object",
        "title": "PipelineMetrics"
      },
      "PipelineRunRequest": {
        "properties": {
          "start_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Date"
          },
          "end_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Date"
          },
          "batch_size": {
            "type": "integer",
            "maximum": 50000.0,
            "minimum": 1.0,
            "title": "Batch Size",
            "default": 1000
          },
          "force_reload": {
            "type": "boolean",
            "title": "Force Reload",
            "default": false
          }
        },
        "type": "object",
        "title": "PipelineRunRequest"
      },
      "PipelineRunResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "start_time": {
            "type": "string",
            "title": "Start Time"
          },
          "end_time": {
            "type": "string",
            "title": "End Time"
          },
          "duration_seconds": {
            "type": "number",
            "title": "Duration Seconds"
          },
          "metrics": {
            "$ref": "#/components/schemas/PipelineMetrics"
          }
        },
        "type": "object",
        "required": [
          "status",
          "job_id",
          "start_time",
          "end_time",
          "duration_seconds",
          "metrics"
        ],
        "title": "PipelineRunResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}