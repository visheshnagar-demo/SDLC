{
  "openapi": "3.1.0",
  "info": {
    "title": "Email Ingestion & AI Categorization API",
    "description": "Backend service for email ingestion (.eml, .msg, .txt), AI classification, and review dashboard.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/emails/text": {
      "post": {
        "tags": [
          "emails"
        ],
        "summary": "Ingest Text Endpoint",
        "description": "Ingest an email via raw text payload and perform AI categorization.",
        "operationId": "ingest_text_endpoint_api_v1_emails_text_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailCreateText"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/emails/upload": {
      "post": {
        "tags": [
          "emails"
        ],
        "summary": "Upload File Endpoint",
        "description": "Ingest an email via file upload (.eml, .msg, .txt up to 10MB) and perform AI categorization.",
        "operationId": "upload_file_endpoint_api_v1_emails_upload_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_file_endpoint_api_v1_emails_upload_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/emails": {
      "get": {
        "tags": [
          "emails"
        ],
        "summary": "List Emails Endpoint",
        "description": "List, search, and filter classified emails with pagination.",
        "operationId": "list_emails_endpoint_api_v1_emails_get",
        "parameters": [
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Skip"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Search"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/emails/{email_id}": {
      "get": {
        "tags": [
          "emails"
        ],
        "summary": "Get Email Endpoint",
        "description": "Retrieve details of a specific email including audit history.",
        "operationId": "get_email_endpoint_api_v1_emails__email_id__get",
        "parameters": [
          {
            "name": "email_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Email Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/emails/{email_id}/override": {
      "patch": {
        "tags": [
          "emails"
        ],
        "summary": "Override Category Endpoint",
        "description": "Manually override the AI classification category for an email.",
        "operationId": "override_category_endpoint_api_v1_emails__email_id__override_patch",
        "parameters": [
          {
            "name": "email_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Email Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryOverride"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_upload_file_endpoint_api_v1_emails_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_file_endpoint_api_v1_emails_upload_post"
      },
      "CategoryOverride": {
        "properties": {
          "category": {
            "type": "string",
            "title": "Category",
            "description": "New category: Work, Personal, Urgent, Promotional, or Uncategorized"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason",
            "description": "Optional reason for the manual override"
          }
        },
        "type": "object",
        "required": [
          "category"
        ],
        "title": "CategoryOverride"
      },
      "ClassificationAuditLogRead": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "email_id": {
            "type": "string",
            "title": "Email Id"
          },
          "previous_category": {
            "type": "string",
            "title": "Previous Category"
          },
          "new_category": {
            "type": "string",
            "title": "New Category"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email_id",
          "previous_category",
          "new_category",
          "created_at"
        ],
        "title": "ClassificationAuditLogRead"
      },
      "EmailCreateText": {
        "properties": {
          "subject": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subject"
          },
          "body": {
            "type": "string",
            "title": "Body",
            "description": "Raw text of the email"
          }
        },
        "type": "object",
        "required": [
          "body"
        ],
        "title": "EmailCreateText"
      },
      "EmailListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/EmailRead"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "skip": {
            "type": "integer",
            "title": "Skip",
            "default": 0
          },
          "limit": {
            "type": "integer",
            "title": "Limit",
            "default": 20
          }
        },
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "title": "EmailListResponse"
      },
      "EmailRead": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "subject": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subject"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "preview": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preview"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name"
          },
          "file_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Type"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "original_category": {
            "type": "string",
            "title": "Original Category"
          },
          "confidence_score": {
            "type": "number",
            "title": "Confidence Score"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "is_overridden": {
            "type": "boolean",
            "title": "Is Overridden"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "audit_logs": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ClassificationAuditLogRead"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audit Logs",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "id",
          "body",
          "category",
          "original_category",
          "confidence_score",
          "status",
          "is_overridden",
          "created_at",
          "updated_at"
        ],
        "title": "EmailRead"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}