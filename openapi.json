{
  "openapi": "3.1.0",
  "info": {
    "title": "Email Classification System API",
    "description": "Intelligent email parsing, multi-category AI classification (Work, Personal, Urgent, Promotional), and review management API.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/emails/classify": {
      "post": {
        "tags": [
          "Emails"
        ],
        "summary": "Classify email content or file",
        "description": "Accepts email text or uploaded file (.eml, .txt, .pdf), extracts headers and body,\nruns AI classification, stores in database, and returns classified email.",
        "operationId": "classify_email_api_v1_emails_classify_post",
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/emails": {
      "get": {
        "tags": [
          "Emails"
        ],
        "summary": "Get classified emails with filtering and search",
        "operationId": "get_classified_emails_api_v1_emails_get",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by category (Work, Personal, Urgent, Promotional)",
              "title": "Category"
            },
            "description": "Filter by category (Work, Personal, Urgent, Promotional)"
          },
          {
            "name": "min_confidence",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number",
                  "maximum": 100.0,
                  "minimum": 0.0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by minimum confidence score",
              "title": "Min Confidence"
            },
            "description": "Filter by minimum confidence score"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Search keyword in subject, sender, or body",
              "title": "Search"
            },
            "description": "Search keyword in subject, sender, or body"
          },
          {
            "name": "date_from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter from ISO date",
              "title": "Date From"
            },
            "description": "Filter from ISO date"
          },
          {
            "name": "date_to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter to ISO date",
              "title": "Date To"
            },
            "description": "Filter to ISO date"
          },
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Pagination skip",
              "default": 0,
              "title": "Skip"
            },
            "description": "Pagination skip"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Pagination limit",
              "default": 20,
              "title": "Limit"
            },
            "description": "Pagination limit"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/emails/metrics": {
      "get": {
        "tags": [
          "Emails"
        ],
        "summary": "Get aggregated email classification metrics",
        "operationId": "get_metrics_api_v1_emails_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/emails/{email_id}": {
      "get": {
        "tags": [
          "Emails"
        ],
        "summary": "Get email details by ID",
        "operationId": "get_email_by_id_api_v1_emails__email_id__get",
        "parameters": [
          {
            "name": "email_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Email Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Emails"
        ],
        "summary": "Override email category classification",
        "operationId": "override_classification_api_v1_emails__email_id__patch",
        "parameters": [
          {
            "name": "email_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Email Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CategoryOverrideRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmailOverrideResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Emails"
        ],
        "summary": "Delete email and associated classification",
        "operationId": "delete_email_api_v1_emails__email_id__delete",
        "parameters": [
          {
            "name": "email_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Email Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Check",
        "operationId": "health_check_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CategoryOverrideRequest": {
        "properties": {
          "category": {
            "type": "string",
            "title": "Category",
            "description": "Target category: Work, Personal, Urgent, or Promotional"
          }
        },
        "type": "object",
        "required": [
          "category"
        ],
        "title": "CategoryOverrideRequest"
      },
      "ClassificationResponse": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "primary_category": {
            "type": "string",
            "title": "Primary Category"
          },
          "ai_category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ai Category"
          },
          "confidence_score": {
            "type": "number",
            "title": "Confidence Score"
          },
          "user_override_category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Override Category"
          },
          "is_overridden": {
            "type": "boolean",
            "title": "Is Overridden",
            "default": false
          },
          "all_scores": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "All Scores"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "primary_category",
          "confidence_score"
        ],
        "title": "ClassificationResponse"
      },
      "EmailListResponse": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "skip": {
            "type": "integer",
            "title": "Skip"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/EmailResponse"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "total",
          "skip",
          "limit",
          "items"
        ],
        "title": "EmailListResponse"
      },
      "EmailOverrideResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "classification": {
            "$ref": "#/components/schemas/ClassificationResponse"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "classification",
          "updated_at"
        ],
        "title": "EmailOverrideResponse"
      },
      "EmailResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "sender": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sender"
          },
          "subject": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subject"
          },
          "excerpt": {
            "type": "string",
            "title": "Excerpt"
          },
          "body_text": {
            "type": "string",
            "title": "Body Text"
          },
          "source_type": {
            "type": "string",
            "title": "Source Type"
          },
          "file_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "File Name"
          },
          "classification": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClassificationResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "excerpt",
          "body_text",
          "source_type",
          "created_at",
          "updated_at"
        ],
        "title": "EmailResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MetricsResponse": {
        "properties": {
          "total_processed": {
            "type": "integer",
            "title": "Total Processed"
          },
          "work_count": {
            "type": "integer",
            "title": "Work Count"
          },
          "personal_count": {
            "type": "integer",
            "title": "Personal Count"
          },
          "urgent_count": {
            "type": "integer",
            "title": "Urgent Count"
          },
          "promotional_count": {
            "type": "integer",
            "title": "Promotional Count"
          },
          "overridden_count": {
            "type": "integer",
            "title": "Overridden Count"
          }
        },
        "type": "object",
        "required": [
          "total_processed",
          "work_count",
          "personal_count",
          "urgent_count",
          "promotional_count",
          "overridden_count"
        ],
        "title": "MetricsResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}