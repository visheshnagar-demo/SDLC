# Environment variables for local development.
# Copy to .env and adjust values:  cp .env.example .env

# Database connection string
DATABASE_URL=sqlite:////tmp/app.db
# Secret key for JWT token signing
JWT_SECRET_KEY=dev-secret-change-in-production
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Read by the backend code (STRIPE_WEBHOOK_SECRET)
STRIPE_WEBHOOK_SECRET=whsec_test_secret

# --- Auto-added at push: vars read by the code but missing above ---
# Read by the backend code (BATCH_TIMEOUT_SECONDS)
BATCH_TIMEOUT_SECONDS=300
# Read by the backend code (BIGQUERY_DATASET)
BIGQUERY_DATASET=analytics
# Read by the backend code (BIGQUERY_TABLE)
BIGQUERY_TABLE=new_sales_orders
# Read by the backend code (GCP_PROJECT)
GCP_PROJECT=changeme
# Read by the backend code (GCS_SOURCE_URI)
GCS_SOURCE_URI=gs://sdlc-workspec-store/etl/data/raw_sales_data.csv
# Read by the backend code (GOOGLE_CLOUD_PROJECT)
GOOGLE_CLOUD_PROJECT=upbeat-repeater-477110-q6
# Read by the backend code (LOG_LEVEL)
LOG_LEVEL=INFO
# Read by the backend code (PARTITION_FIELD)
PARTITION_FIELD=created_at
