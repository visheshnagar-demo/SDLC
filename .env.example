# Environment variables for local development.
# Copy to .env and adjust values:  cp .env.example .env

# Database connection string
DATABASE_URL=sqlite:////tmp/app.db
# Secret key for JWT token signing
JWT_SECRET_KEY=dev-secret-change-in-production
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Read by the backend code (STRIPE_WEBHOOK_SECRET)
STRIPE_WEBHOOK_SECRET=whsec_test_secret

# --- Auto-added at push: vars read by the code but missing above ---
# Read by the backend code (ENVIRONMENT)
ENVIRONMENT=development
# Read by the backend code (TESTING)
TESTING=false
