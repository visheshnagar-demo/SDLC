    },
    {
      "step": "null_standardization",
      "type": "cleaning",
      "description": "Normalize empty string and string null representations ('NULL', 'None', 'NaN', 'N/A') to None/null",
      "columns": ["id", "name", "email", "status", "data_val"]
    },
    {
      "step": "deduplication",
